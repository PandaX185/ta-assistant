<?xml version="1.0" encoding="utf-8"?>
<!--
  `<root-path>` maps to the filesystem root `/`. Tauri's appDataDir() on Android
  resolves to the app's data directory (e.g. /data/user/0/<pkg>), which is NOT
  under getFilesDir() or getCacheDir(), so neither <files-path> nor <cache-path>
  can reach it. A root-path is required to share stored attachments and
  downloaded updates. Only this plugin ever constructs URIs against this
  provider, and the ACTION_VIEW intent we build grants the receiver a single
  read right, so the broad root is contained.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <root-path name="app_data" path="." />
</paths>