<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Self-contained provider with a unique authority AND a unique class
             name (OpenFileProvider) so it never clashes with the FileProvider
             the host app already declares. The manifest merger keys providers
             by android:name; reusing androidx.core.content.FileProvider would
             make one authority silently disappear on merge. -->
        <provider
            android:name="com.pandax185.taassistant.fileopen.OpenFileProvider"
            android:authorities="${applicationId}.open.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/open_file_paths" />
        </provider>
    </application>

</manifest>